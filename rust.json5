{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  packageRules: [
    // ==========================================================================
    // monorepo grouping
    // ==========================================================================
    // clap-rs/clap is not included in Renovate's built-in `group:monorepos`
    // preset, so group it manually by sourceUrl.
    {
      matchManagers: ['cargo'],
      matchSourceUrls: ['https://github.com/clap-rs/clap'],
      groupName: 'clap monorepo',
    },

    // ==========================================================================
    // grouping
    // ==========================================================================
    // Group rust-toolchain and Docker image updates together so a Rust
    // version bump lands in a single PR; all three managers resolve
    // `depName`/`packageName` to `rust`.
    {
      matchManagers: ['rust-toolchain', 'dockerfile', 'docker-compose'],
      matchPackageNames: ['rust'],
      groupName: 'rust toolchain',
    },

    // ==========================================================================
    // automerge
    // ==========================================================================
    {
      matchManagers: ['cargo'],
      matchDepTypes: ['dev-dependencies'],
      matchUpdateTypes: ['patch'],
      groupName: 'dev-dependencies (non-major)',
      automerge: true,
    },
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['patch', 'pin', 'digest'],
      automerge: true,
    },
    // Rust guarantees backward compatibility within an edition, so toolchain
    // patch/minor bumps are safe to automerge.
    {
      matchManagers: ['rust-toolchain', 'dockerfile', 'docker-compose'],
      matchPackageNames: ['rust'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
    },
  ],
}
