{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  packageRules: [
    // ==========================================================================
    // monorepo grouping
    // ==========================================================================
    // clap-rs/clap is not included in Renovate's built-in `group:monorepos`
    // preset, so group it manually by sourceUrl.
    {
      matchManagers: ['cargo'],
      matchSourceUrls: ['https://github.com/clap-rs/clap'],
      groupName: 'clap monorepo',
    },

    // ==========================================================================
    // grouping
    // ==========================================================================
    // Group rust-toolchain and Docker image updates together so a Rust
    // version bump lands in a single PR; all three managers resolve
    // `depName`/`packageName` to `rust`.
    {
      matchManagers: ['rust-toolchain', 'dockerfile', 'docker-compose'],
      matchPackageNames: ['rust'],
      groupName: 'rust toolchain',
    },
    {
      // 後ろの rule の groupName が優先されるため、rusqlite 用 group より前に置く。
      matchManagers: ['cargo'],
      matchDepTypes: ['dev-dependencies'],
      matchUpdateTypes: ['patch'],
      groupName: 'dev-dependencies (non-major)',
    },
    {
      // 片方だけ major 更新でも、同じ依存更新を別 branch に分けないようにする。
      matchManagers: ['cargo'],
      matchPackageNames: ['rusqlite', 'rusqlite_migration'],
      groupName: 'rusqlite dependencies',
      separateMajorMinor: false,
    },

    // ==========================================================================
    // automerge
    // ==========================================================================
    {
      matchManagers: ['cargo'],
      matchDepTypes: ['dev-dependencies'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['patch', 'pin', 'digest'],
      automerge: true,
    },
    // Rust guarantees backward compatibility within an edition, so toolchain
    // patch/minor bumps are safe to automerge.
    {
      matchManagers: ['rust-toolchain', 'dockerfile', 'docker-compose'],
      matchPackageNames: ['rust'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
    },
  ],
}
