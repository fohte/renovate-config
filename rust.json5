{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  packageRules: [
    // ==========================================================================
    // generic-boilerplate (https://github.com/fohte/generic-boilerplate)
    // ==========================================================================
    {
      matchRepositories: ['!fohte/generic-boilerplate'],
      matchManagers: ['cargo'],
      matchPackageNames: ['rstest', 'thiserror'],
      enabled: false,
    },

    // ==========================================================================
    // monorepo grouping
    // ==========================================================================
    // clap-rs/clap is not included in Renovate's built-in `group:monorepos`
    // preset, so group it manually by sourceUrl.
    {
      matchManagers: ['cargo'],
      matchSourceUrls: ['https://github.com/clap-rs/clap'],
      groupName: 'clap monorepo',
    },

    // ==========================================================================
    // automerge
    // ==========================================================================
    {
      matchManagers: ['cargo'],
      matchDepTypes: ['dev-dependencies'],
      matchUpdateTypes: ['patch'],
      groupName: 'dev-dependencies (non-major)',
      automerge: true,
    },
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['patch', 'pin', 'digest'],
      automerge: true,
    },
  ],
}
