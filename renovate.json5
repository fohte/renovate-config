{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>fohte/renovate-config:base.json5',
    'github>fohte/renovate-config:node.json5',
  ],

  packageRules: [
    {
      // Use "latest" tag in package.json to always get the latest version for E2E tests.
      // Only update lockfile when new versions are released, keeping package.json unchanged.
      matchPackageNames: ['renovate'],
      rangeStrategy: 'update-lockfile',
    },
    // Use 'bump' rangeStrategy for Node.js in mise.
    // Major-only versions (e.g., "24") let `mise install` pick the latest patch
    // automatically. The global 'pin' strategy would pin to an exact version
    // (e.g., "24" -> "v24.13.1"), but minor/patch precision is unnecessary
    // since Node.js is only used for running tests in this repository.
    {
      matchManagers: ['mise'],
      matchDatasources: ['node-version'],
      rangeStrategy: 'bump',
    },
  ],
}
