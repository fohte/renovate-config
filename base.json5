{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: ['config:recommended', ':enablePreCommit'],

  configMigration: true,
  timezone: 'Asia/Tokyo',

  // Wait 7 days after a package release before creating a PR.
  // This helps mitigate supply chain attacks by allowing time for
  // security researchers and automated tools to detect malicious packages.
  minimumReleaseAge: '7 days',

  // set this to unlimited to ensure that a new PR is created so
  // we can notice when a version upgrade is available,
  // even if the previous PR hasn't been merged.
  // default: 2 (config:recommended)
  prHourlyLimit: 0,

  // `prHoulyLimit: 1` may cause GitHub API rate limit, so limit parallel
  prConcurrentLimit: 5,

  // prevent Renovate from blocking automatic rebases when these authors commit.
  // without this, Renovate shows "Edited/Blocked Notification" and won't auto-rebase
  // if it detects commits from unrecognized authors, requiring manual intervention.
  gitIgnoredAuthors: [
    '139195068+fohte-bot[bot]@users.noreply.github.com', // Fohte bot (https://github.com/apps/fohte-bot)
    '41898282+github-actions[bot]@users.noreply.github.com', // GitHub Actions
  ],

  lockFileMaintenance: {
    enabled: true,
    schedule: 'before 5am on Saturday',
    automerge: true,
  },

  // use exact version instead of range
  // e.g. "typescript": "^3.9.7" -> "typescript": "3.9.7"
  // ref: https://docs.renovatebot.com/dependency-pinning
  rangeStrategy: 'pin',

  // Note: packageRules are evaluated in order and later rules override earlier ones.
  packageRules: [
    // ==========================================================================
    // trusted updates
    // ==========================================================================
    // Prioritize trusted updates to ensure they are processed first.
    // Lockfile maintenance PRs unblock Renovate self-healing.
    {
      matchUpdateTypes: ['lockFileMaintenance'],
      prPriority: 100,
    },
    // Internal packages: skip minimumReleaseAge delay since they are trusted.
    {
      matchSourceUrls: ['https://github.com/fohte/**'],
      minimumReleaseAge: null,
      prPriority: 100,
    },

    // ==========================================================================
    // automerge
    // ==========================================================================
    // Automerge low-risk updates to reduce PR noise.
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },

    // ==========================================================================
    // labels
    // ==========================================================================
    // Add labels based on update type for easier PR filtering.
    {
      matchUpdateTypes: ['major'],
      addLabels: ['renovate/major'],
    },
    {
      matchUpdateTypes: ['minor'],
      addLabels: ['renovate/minor'],
    },
    {
      matchUpdateTypes: ['patch'],
      addLabels: ['renovate/patch'],
    },

    // ==========================================================================
    // release-please integration
    // ==========================================================================
    // Semantic commit types for release-please version bumps.
    // release-please treats these commit types as:
    //   - feat  -> minor bump
    //   - fix   -> patch bump
    //   - deps  -> patch bump (shown in "Dependencies" section)
    //   - chore -> no bump
    //   - ci    -> no bump
    //   - !     -> major bump (breaking change)
    //
    // Resulting semantic commit types:
    //   | Target          | major    | minor  | patch  | pin    |
    //   |-----------------|----------|--------|--------|--------|
    //   | dependencies    | deps!:   | deps:  | deps:  | chore: |
    //   | devDependencies | chore:   | chore: | chore: | chore: |
    //   | github-actions  | ci:      | ci:    | ci:    | ci:    |
    //   | copier          | chore:   | chore: | chore: | chore: |
    {
      matchUpdateTypes: ['major'],
      commitMessagePrefix: 'deps!:',
    },
    {
      matchUpdateTypes: ['minor', 'patch'],
      semanticCommitType: 'deps',
      semanticCommitScope: null,
    },
    // Pin updates don't change runtime behavior, so exclude from CHANGELOG.
    {
      matchUpdateTypes: ['pin'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
    },
    {
      matchDepTypes: ['devDependencies'],
      // Use commitMessagePrefix (not semanticCommitType) to override the
      // 'deps!:' prefix set above for major updates.
      commitMessagePrefix: 'chore:',
      semanticCommitScope: null,
    },
    {
      matchManagers: ['github-actions'],
      commitMessagePrefix: 'ci:',
      semanticCommitScope: null,
    },
    // Copier templates are boilerplate references, not runtime/dev dependencies.
    {
      matchManagers: ['copier'],
      commitMessagePrefix: 'chore(deps):',
      semanticCommitScope: null,
    },

    // ==========================================================================
    // pre-commit
    // ==========================================================================
    // Schedule updates on Saturday to batch with lockFileMaintenance.
    // Automerge minor/patch since pre-commit hooks rarely have breaking changes.
    {
      matchManagers: ['pre-commit'],
      schedule: 'after 9am on Saturday',
    },
    {
      matchManagers: ['pre-commit'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },

    // ==========================================================================
    // copier
    // ==========================================================================
    // For copier templates with GitHub URL package names,
    // use only the repository name in commit messages instead of the full URL.
    // Handles both https://github.com/owner/repo and https://github.com/owner/repo.git
    {
      matchManagers: ['copier'],
      matchPackageNames: ['/^https:\\/\\/github\\.com\\//'],
      commitMessageTopic: '{{{replace "\\.git$" "" (replace "https://github\\.com/[^/]+/" "" packageName)}}}',
    },

    // ==========================================================================
    // mise
    // ==========================================================================
    // Use 'bump' rangeStrategy for mise's cargo backend packages.
    // The global 'pin' strategy adds an '=' prefix (e.g., "0.1.0" -> "=0.1.0"),
    // which is invalid for mise. 'bump' updates the version without adding a prefix,
    // ensuring versions are updated correctly (e.g., "0.1.0" -> "0.2.0").
    {
      matchManagers: ['mise'],
      matchDatasources: ['crate'],
      rangeStrategy: 'bump',
    },

    // ==========================================================================
    // generic-boilerplate (https://github.com/fohte/generic-boilerplate)
    // ==========================================================================
    // Disable updates for tools/packages managed by generic-boilerplate.
    // These are updated in generic-boilerplate and synced to other repos via copier.
    // Excluded from generic-boilerplate itself since that's where updates should happen.
    {
      matchRepositories: ['!fohte/generic-boilerplate'],
      matchManagers: ['mise'],
      matchDepNames: [
        'actionlint',
        'bun',
        'cargo:basefmt',
        'lefthook',
        'shellcheck',
        'shfmt',
      ],
      enabled: false,
    },
    {
      matchRepositories: ['!fohte/generic-boilerplate'],
      matchManagers: ['mise'],
      matchDepNames: ['npm:@commitlint/cli', 'npm:prettier'],
      enabled: false,
    },
  ],
}
