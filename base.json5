{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',
    ':enablePreCommit',
    // Pin GitHub Action `uses:` to immutable SHA digests, and emit the
    // accompanying version comment as a full SemVer (e.g. `# v3.1.0`) instead
    // of the floating major tag Renovate would otherwise pick (`# v3`). This
    // matches the "pinact" style (suzuki-shunsuke/pinact) so downstream repos
    // can read the exact version at a glance while still resolving to a SHA.
    //
    // `helpers:pinGitHubActionDigestsToSemver` extends
    // `helpers:pinGitHubActionDigests` internally and adds an `extractVersion`
    // that only matches `vX.Y.Z` tags, filtering out floating tags like `v3`.
    // See https://docs.renovatebot.com/presets-helpers/#helperspingithubactiondigeststosemver
    'helpers:pinGitHubActionDigestsToSemver',
    'customManagers:githubActionsVersions',
    // https://docs.renovatebot.com/presets-group/#groupmonorepos
    'group:monorepos',
  ],

  configMigration: true,
  timezone: 'Asia/Tokyo',

  customManagers: [
    {
      // Track `jdx/mise-action`'s `with: version:` as a `jdx/mise` release.
      // mise-action has no equivalent of `actions/setup-node`'s `.nvmrc`
      // support, so a pinned mise version drifts silently without this
      // manager. The regex is scoped to the `with:` block of a
      // `jdx/mise-action@...` step so it only matches version keys belonging
      // to that action.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/'],
      // Anchored to a `uses:` line so a stray `jdx/mise-action@…` mention
      // inside a `run:` script or comment cannot trigger extraction. The
      // continuation pattern `[ \t]+[^-\s]` stops at the next step boundary;
      // a YAML list value inside `with:` (line starting with `-`) also
      // terminates the match, so a sibling `version:` placed after such a
      // list would be missed.
      matchStrings: [
        '[ \\t]+(?:- )?uses:[ \\t]+jdx/mise-action@\\S+[^\\n]*\\n[ \\t]+with:[ \\t]*\\n(?:[ \\t]+[^-\\s][^\\n]*\\n)*?[ \\t]+version:\\s*(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'jdx/mise',
      // mise tags are `vX.Y.Z` but `with: version:` is consumed without the
      // leading `v`, so strip it from the looked-up version.
      extractVersionTemplate: '^v(?<version>.+)$',
    },
  ],

  // octo-sts rejects OIDC token subjects containing any of `"'`\<>;&$(){}[]`,
  // so a branch like `renovate/devdependencies-(non-major)` produces a subject
  // that fails token exchange with `invalid subject in token` and blocks the
  // PR's required status checks.
  branchNameStrict: true,

  // Wait 7 days after a package release before creating a PR.
  // This helps mitigate supply chain attacks by allowing time for
  // security researchers and automated tools to detect malicious packages.
  minimumReleaseAge: '7 days',

  // set this to unlimited to ensure that a new PR is created so
  // we can notice when a version upgrade is available,
  // even if the previous PR hasn't been merged.
  // default: 2 (config:recommended)
  prHourlyLimit: 0,

  // `prHoulyLimit: 1` may cause GitHub API rate limit, so limit parallel
  prConcurrentLimit: 5,

  // prevent Renovate from blocking automatic rebases when these authors commit.
  // without this, Renovate shows "Edited/Blocked Notification" and won't auto-rebase
  // if it detects commits from unrecognized authors, requiring manual intervention.
  gitIgnoredAuthors: [
    '139195068+fohte-bot[bot]@users.noreply.github.com', // Fohte bot (https://github.com/apps/fohte-bot)
    '41898282+github-actions[bot]@users.noreply.github.com', // GitHub Actions
  ],

  lockFileMaintenance: {
    enabled: true,
    schedule: 'before 5am on Saturday',
    automerge: true,
  },

  // use exact version instead of range
  // e.g. "typescript": "^3.9.7" -> "typescript": "3.9.7"
  // ref: https://docs.renovatebot.com/dependency-pinning
  rangeStrategy: 'pin',

  // Note: packageRules are evaluated in order and later rules override earlier ones.
  packageRules: [
    // ==========================================================================
    // trusted updates
    // ==========================================================================
    // Prioritize trusted updates to ensure they are processed first.
    // Lockfile maintenance PRs unblock Renovate self-healing.
    {
      matchUpdateTypes: ['lockFileMaintenance'],
      // Lock file maintenance regenerates lock files without version constraints,
      // so individual package release timestamps are unavailable. Since Renovate 42+
      // treats missing timestamps as failing minimumReleaseAge, this would cause
      // the PR to be pending indefinitely. Disable the check for this update type.
      minimumReleaseAge: null,
      prPriority: 100,
    },
    // Internal packages: skip minimumReleaseAge delay since they are trusted.
    {
      matchSourceUrls: ['https://github.com/fohte/**'],
      minimumReleaseAge: null,
      prPriority: 100,
    },

    // ==========================================================================
    // automerge
    // ==========================================================================
    // Automerge low-risk updates to reduce PR noise.
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['patch', 'digest'],
      automerge: true,
    },
    // GitHub-official actions (`actions/*`) reserve breaking changes for major
    // releases; minor releases only add features or inputs. Third-party
    // actions don't guarantee this, so this rule is scoped to `actions/*` only.
    {
      matchManagers: ['github-actions'],
      matchPackageNames: ['actions/**'],
      matchUpdateTypes: ['minor'],
      automerge: true,
    },

    // ==========================================================================
    // labels
    // ==========================================================================
    // Add labels based on update type for easier PR filtering.
    {
      matchUpdateTypes: ['major'],
      addLabels: ['renovate/major'],
    },
    {
      matchUpdateTypes: ['minor'],
      addLabels: ['renovate/minor'],
    },
    {
      matchUpdateTypes: ['patch'],
      addLabels: ['renovate/patch'],
    },

    // ==========================================================================
    // release-please integration
    // ==========================================================================
    // Semantic commit types for release-please version bumps.
    // release-please treats these commit types as:
    //   - feat  -> minor bump
    //   - fix   -> patch bump
    //   - deps  -> patch bump (shown in "Dependencies" section)
    //   - chore -> no bump
    //   - ci    -> no bump
    //   - !     -> major bump (breaking change)
    //
    // Resulting semantic commit types:
    //   | Target          | major        | minor        | patch        | pin          |
    //   |-----------------|--------------|--------------|--------------|--------------|
    //   | dependencies    | deps:        | deps:        | deps:        | chore(deps): |
    //   | devDependencies | chore:       | chore:       | chore:       | chore:       |
    //   | github-actions  | ci:          | ci:          | ci:          | ci:          |
    //   | mise            | chore:       | chore:       | chore:       | chore:       |
    //   | jdx/mise        | ci:          | ci:          | ci:          | ci:          |
    {
      matchUpdateTypes: ['major', 'minor', 'patch'],
      semanticCommitType: 'deps',
      semanticCommitScope: null,
    },
    // Pin updates don't change runtime behavior, so exclude from CHANGELOG.
    {
      matchUpdateTypes: ['pin'],
      semanticCommitType: 'chore',
      semanticCommitScope: 'deps',
    },
    {
      matchDepTypes: ['devDependencies'],
      commitMessagePrefix: 'chore:',
      semanticCommitScope: null,
    },
    {
      matchManagers: ['github-actions'],
      commitMessagePrefix: 'ci:',
      semanticCommitScope: null,
    },

    // ==========================================================================
    // copier
    // ==========================================================================
    // Disable Renovate-managed updates for `fohte/generic-boilerplate`.
    // Consumer repositories update this template via `fohte/copier-update-action`
    // (invoked from `boilerplate-update.yml`) instead of Renovate's copier manager.
    {
      matchManagers: ['copier'],
      matchPackageNames: ['/fohte\\/generic-boilerplate(?:\\.git)?$/'],
      enabled: false,
    },

    // ==========================================================================
    // pre-commit
    // ==========================================================================
    // Schedule updates on Saturday to batch with lockFileMaintenance.
    // Automerge minor/patch since pre-commit hooks rarely have breaking changes.
    {
      matchManagers: ['pre-commit'],
      schedule: 'after 9am on Saturday',
    },
    {
      matchManagers: ['pre-commit'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },

    // ==========================================================================
    // mise
    // ==========================================================================
    // Use 'bump' rangeStrategy for mise's cargo backend packages.
    // The global 'pin' strategy adds an '=' prefix (e.g., "0.1.0" -> "=0.1.0"),
    // which is invalid for mise. 'bump' updates the version without adding a prefix,
    // ensuring versions are updated correctly (e.g., "0.1.0" -> "0.2.0").
    {
      matchManagers: ['mise'],
      matchDatasources: ['crate'],
      rangeStrategy: 'bump',
    },
    // mise tools are development-only (not runtime dependencies), so use 'chore:'
    // to prevent release-please from triggering unnecessary patch bumps.
    {
      matchManagers: ['mise'],
      commitMessagePrefix: 'chore:',
      semanticCommitScope: null,
    },
    // jdx/mise is extracted by our customManager from `jdx/mise-action`'s
    // `with: version:` and is effectively a GitHub Actions workflow input, not
    // a runtime or dev dependency. The customManager's manager name is `regex`,
    // so the `github-actions` rule above does not match it; declare the `ci:`
    // prefix here to keep release-please from emitting patch bumps for it.
    //
    // It also releases under CalVer (`YYYY.M.PATCH`), so Renovate's
    // patch/minor/major classification does not reflect risk; automerge all
    // updates. See https://mise.jdx.dev/faq.html
    {
      matchPackageNames: ['jdx/mise'],
      commitMessagePrefix: 'ci:',
      semanticCommitScope: null,
      automerge: true,
    },
    // Automerge minor/patch for mise-managed formatter/linter/git-hook CLIs.
    // Excludes tools with broad blast radius (language runtimes, package
    // managers, infra/cluster CLIs) and security scanners (e.g. betterleaks)
    // whose regressions can fail silently.
    //
    // Matched by upstream packageName (not the mise.toml key) so both short
    // registry names (e.g. `lefthook`) and explicit backend-prefixed names
    // (e.g. `aqua:evilmartians/lefthook`) resolve to the same rule.
    {
      matchManagers: ['mise'],
      matchPackageNames: [
        'evilmartians/lefthook', // lefthook
        'rhysd/actionlint', // actionlint
        'suzuki-shunsuke/pinact', // pinact
        'koalaman/shellcheck', // shellcheck
        'mvdan/sh', // shfmt
        '@commitlint/cli', // npm:@commitlint/cli
        'prettier', // npm:prettier
        // mise's registry resolves the bare `prettier` short name (no
        // `npm:` prefix) to the prettier/prettier GitHub repo via
        // github-releases, not the npm package.
        'prettier/prettier', // prettier
        'ast-grep/ast-grep', // github:ast-grep/ast-grep
      ],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    // Automerge patch updates for mise-managed `node`. mise-managed node is
    // a dev-tool runtime (running local linters/formatters), never the
    // production runtime -- that's pinned separately (Dockerfile, Lambda
    // runtime, package.json engines). LTS patch releases preserve backward
    // compatibility, and a broken patch surfaces via CI lint/format
    // failures. Minor is excluded since it can add new features.
    {
      matchManagers: ['mise'],
      matchPackageNames: ['node'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
  ],
}
