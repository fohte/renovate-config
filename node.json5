{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  packageRules: [
    // ==========================================================================
    // generic-boilerplate (https://github.com/fohte/generic-boilerplate)
    // ==========================================================================
    // Disable updates for packages managed by generic-boilerplate.
    // These packages are updated in generic-boilerplate and synced via copier.
    // Note: generic-boilerplate itself does NOT extend node.json5.
    {
      // @auto-generated sync:generic-boilerplate:npm-packages start
      matchPackageNames: [
        '@commitlint/cli',
        '@fohte/eslint-config',
        '@tsconfig/bun',
        '@types/bun',
        'concurrently',
        'eslint',
        'prettier',
        'typescript',
        'vitest',
      ],
      // @auto-generated sync:generic-boilerplate:npm-packages end
      enabled: false,
    },
    {
      matchManagers: ['mise'],
      // @auto-generated sync:generic-boilerplate:mise-npm-backend start
      matchPackageNames: ['npm:@commitlint/cli', 'npm:prettier'],
      // @auto-generated sync:generic-boilerplate:mise-npm-backend end
      enabled: false,
    },

    // ==========================================================================
    // automerge
    // ==========================================================================
    {
      matchManagers: ['npm', 'bun'],
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['patch'],
      groupName: 'devDependencies (non-major)',
      automerge: true,
    },
    {
      matchManagers: ['npm', 'bun'],
      matchUpdateTypes: ['patch', 'pin', 'digest'],
      automerge: true,
    },
    {
      // @cloudflare/workers-types uses date-based versioning (<major>.<YYYYMMDD>.<patch>),
      // but we can safely automerge since CI type checking ensures compatibility
      matchPackageNames: ['@cloudflare/workers-types'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },

    // ==========================================================================
    // grouping
    // ==========================================================================
    // Group Bun runtime and its type definitions together
    // to ensure compatibility between runtime and types.
    {
      matchManagers: ['mise'],
      matchPackageNames: ['bun'],
      groupName: 'bun',
    },
    {
      matchManagers: ['npm', 'bun'],
      matchPackageNames: ['@types/bun', 'bun-types'],
      groupName: 'bun',
    },

    // ==========================================================================
    // rangeStrategy
    // ==========================================================================
    {
      // Keep peerDependencies range specifications (e.g., ^6.0.0 || ^7.0.0)
      // to maintain flexibility for consuming projects
      matchManagers: ['npm', 'bun'],
      matchDepTypes: ['peerDependencies'],
      rangeStrategy: 'auto',
    },
  ],
}
