{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  packageRules: [
    // ==========================================================================
    // generic-boilerplate (https://github.com/fohte/generic-boilerplate)
    // ==========================================================================
    // Disable updates for npm packages managed by generic-boilerplate.
    // These are updated in generic-boilerplate and synced to other repos via copier.
    // Excluded from generic-boilerplate itself since that's where updates should happen.
    {
      matchRepositories: ['!fohte/generic-boilerplate'],
      // @auto-generated sync:generic-boilerplate:npm-packages start
      matchPackageNames: [
        '@commitlint/cli',
        '@fohte/eslint-config',
        '@tsconfig/bun',
        '@types/bun',
        'concurrently',
        'eslint',
        'prettier',
        'typescript',
        'vitest',
      ],
      // @auto-generated sync:generic-boilerplate:npm-packages end
      enabled: false,
    },

    // ==========================================================================
    // automerge
    // ==========================================================================
    {
      matchManagers: ['npm', 'bun'],
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['patch'],
      groupName: 'devDependencies (non-major)',
      automerge: true,
    },
    {
      matchManagers: ['npm', 'bun'],
      matchUpdateTypes: ['patch', 'pin', 'digest'],
      automerge: true,
    },
    {
      // @cloudflare/workers-types uses date-based versioning (<major>.<YYYYMMDD>.<patch>),
      // but we can safely automerge since CI type checking ensures compatibility
      matchPackageNames: ['@cloudflare/workers-types'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },

    // ==========================================================================
    // grouping
    // ==========================================================================
    // Group Bun runtime and its type definitions together
    // to ensure compatibility between runtime and types.
    {
      matchManagers: ['mise'],
      matchPackageNames: ['bun'],
      groupName: 'bun',
    },
    {
      matchManagers: ['npm', 'bun'],
      matchPackageNames: ['@types/bun', 'bun-types'],
      groupName: 'bun',
    },

    // ==========================================================================
    // rangeStrategy
    // ==========================================================================
    {
      // Keep peerDependencies range specifications (e.g., ^6.0.0 || ^7.0.0)
      // to maintain flexibility for consuming projects
      matchManagers: ['npm', 'bun'],
      matchDepTypes: ['peerDependencies'],
      rangeStrategy: 'auto',
    },
    // Use 'bump' rangeStrategy for Node.js in mise.
    // Major-only versions (e.g., "24") let `mise install` pick the latest patch
    // automatically. The global 'pin' strategy would pin to an exact version
    // (e.g., "24" -> "v24.13.1"), but minor/patch precision is unnecessary
    // since Node.js is only used for running tests in this repository.
    {
      matchManagers: ['mise'],
      matchDatasources: ['node-version'],
      rangeStrategy: 'bump',
    },
  ],
}
