{
  "name": "renovate-config",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
