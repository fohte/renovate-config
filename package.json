  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@eslint/eslintrc": "3.3.5",
    "@fohte/eslint-config": "0.3.1",
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.12.4",
    "concurrently": "9.2.1",
    "eslint": "10.4.0",
    "json5": "2.2.3",
    "nock": "14.0.15",
    "prettier": "3.8.3",
    "renovate": "43.128.1",
    "smol-toml": "1.6.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
