{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Enable Copier manager to keep Copier templates up-to-date.
  // ref: https://docs.renovatebot.com/modules/manager/copier/
  copier: {
    enabled: true,
  },

  packageRules: [
    {
      matchManagers: ['copier'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
  ],
}
